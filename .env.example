# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_SOCKET_URL: Address of the always-on Socket.io game server.
# Leave unset to connect to the same host the page was loaded from (e.g. Render,
# where server.ts serves both the Next.js app and the Socket.io server together).
# Set this when the frontend is deployed separately on a serverless platform like
# Vercel, which cannot run the persistent server.ts process — point it at the game
# server's own host (e.g. Render, Railway, Fly.io) instead.
# NEXT_PUBLIC_SOCKET_URL="https://your-game-server.onrender.com"
